{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "orchestrator",
  "env": {
    "DEVTEAM_RUNS_DIR": ".devteam/runs"
  },
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write(.devteam/**)",
      "Edit(.devteam/**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)",
      "Bash(git fetch:*)",
      "Bash(git merge-base:*)",
      "Bash(git add:*)",
      "Bash(git stash:*)",
      "Bash(git --version)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(npx --version)",
      "Bash(claude mcp list:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm ls:*)",
      "Bash(npm audit:*)",
      "Bash(npx tsc:*)",
      "Bash(npx next:*)",
      "Bash(npx vitest:*)",
      "Bash(npx playwright:*)",
      "Bash(npx create-next-app:*)",
      "Bash(node .devteam/bin/*)",
      "Bash(node .devteam/bin/sync-gates.mjs:*)",
      "Bash(node .devteam/bin/utilisation-check.mjs:*)",
      "Bash(node .claude/skills/*/scripts/*)",
      "Bash(node scripts/check.mjs)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(sort:*)",
      "Bash(date:*)",
      "Bash(mkdir:*)",
      "mcp__supabase__search_docs",
      "mcp__supabase__list_tables",
      "mcp__supabase__list_extensions",
      "mcp__supabase__list_migrations",
      "mcp__supabase__apply_migration",
      "mcp__supabase__execute_sql",
      "mcp__supabase__get_logs",
      "mcp__supabase__get_advisors",
      "mcp__supabase__get_project_url",
      "mcp__supabase__get_publishable_keys",
      "mcp__supabase__get_anon_key",
      "mcp__supabase__generate_typescript_types",
      "mcp__supabase__list_edge_functions",
      "mcp__supabase__get_edge_function",
      "mcp__supabase__deploy_edge_function",
      "mcp__supabase__list_branches",
      "mcp__supabase__list_storage_buckets",
      "mcp__supabase__get_storage_config",
      "mcp__supabase__get_project",
      "mcp__playwright"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(gh pr:*)",
      "Bash(gh release:*)",
      "Bash(npm publish:*)",
      "mcp__supabase__create_branch",
      "mcp__supabase__delete_branch",
      "mcp__supabase__merge_branch",
      "mcp__supabase__reset_branch",
      "mcp__supabase__rebase_branch",
      "mcp__supabase__update_storage_config",
      "mcp__supabase__pause_project",
      "mcp__supabase__restore_project",
      "mcp__supabase__create_project",
      "mcp__supabase__get_cost",
      "mcp__supabase__confirm_cost",
      "mcp__playwright__browser_file_upload",
      "mcp__playwright__browser_drop",
      "Edit(.devteam/bin/**)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/secrets/**)",
      "mcp__playwright__browser_run_code_unsafe",
      "Read(~/.claude/.credentials.json)"
    ]
  }
}
