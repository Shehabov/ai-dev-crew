# Run records. Every run writes its plan, handoffs and evidence here. They stay on the
# machine that ran them; BUGS.md, the ADRs and the release note carry what matters.
.devteam/runs/

# Dependencies
node_modules/

# Environment. Keys never reach the repository. .env.example is the committed template.
.env
.env.*
!.env.example

