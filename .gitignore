.next/
next-env.d.ts
*.tsbuildinfo
playwright-report/
test-results/
coverage/
build/
dist/
*.log
*.tmp

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Editors
.idea/
.vscode/
*.swp
*~
